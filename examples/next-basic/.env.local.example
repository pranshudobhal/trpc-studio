# tRPC Studio Configuration
# Copy this file to .env.local and update the values

# Enable tRPC Studio in production (disabled by default for security)
# In development, tRPC Studio is enabled by default
TRPC_STUDIO_ENABLED=true

# Strong random token for production access
# Generate with: openssl rand -base64 32
# This token is required when TRPC_STUDIO_ENABLED=true in production
TRPC_STUDIO_TOKEN=your-super-secret-token-here

# Next.js Configuration
NODE_ENV=development
PORT=3000

# Optional: Custom tRPC Studio paths (defaults shown)
# TRPC_STUDIO_PATH=/trpc-studio
# TRPC_STUDIO_INTROSPECTION_PATH=/__trpc-studio__/introspection

# Optional: Custom tRPC endpoint (default shown)
# TRPC_ENDPOINT=/api/trpc

# Example production configuration:
# NODE_ENV=production
# TRPC_STUDIO_ENABLED=true
# TRPC_STUDIO_TOKEN=abc123xyz789secrettoken
# VERCEL_URL=your-app.vercel.app