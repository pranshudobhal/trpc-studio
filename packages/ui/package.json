{
  "name": "@trpc-studio/ui",
  "version": "0.1.0",
  "description": "React UI components for tRPC Studio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles/globals.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/styles && cp src/styles/globals.css dist/styles/globals.css",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.js",
    "lint": "echo 'No linting for ui'",
    "e2e": "echo 'No E2E for ui'"
  },
  "engines": {
    "node": ">=18.18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@hookform/resolvers": "^3",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-scroll-area": "^1",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-tabs": "^1",
    "@radix-ui/react-toggle": "^1",
    "@radix-ui/react-tooltip": "^1",
    "@trpc-studio/core": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2",
    "lucide-react": "^0.263.1",
    "react-hook-form": "^7",
    "react-json-view-lite": "^2.5.0",
    "react-window": "^1.8.8",
    "tailwind-merge": "^2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-window": "^1.8.8",
    "jsdom": "^23.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "keywords": [
    "trpc",
    "react",
    "ui",
    "components",
    "tailwind"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trpc-studio/trpc-studio.git",
    "directory": "packages/ui"
  }
}
