{
  "name": "@trpc-studio/ui",
  "version": "1.0.0",
  "description": "React UI components for tRPC Studio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles/globals.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc --build && pnpm exec tailwindcss -i ./src/styles/globals.css -o ./dist/styles/globals.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "size": "bundlesize"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@trpc-studio/core": "workspace:*",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-scroll-area": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "react-hook-form": "^7.0.0",
    "@hookform/resolvers": "^3.0.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "vitest": "^1.0.0",
    "tailwindcss": "^3.4.0",
    "bundlesize": "^0.18.0"
  },
  "bundlesize": [
    {
      "path": "./dist/index.js",
      "maxSize": "300kb",
      "compression": "gzip"
    }
  ],
  "keywords": [
    "trpc",
    "react",
    "ui",
    "components",
    "tailwind"
  ],
  "author": "tRPC Studio Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trpc/trpc-studio.git",
    "directory": "packages/ui"
  }
}
