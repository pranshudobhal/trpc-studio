{
  "name": "@trpc-studio/express",
  "version": "1.0.0",
  "description": "Express adapter for tRPC Studio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trpc-studio/core": "workspace:*",
    "@trpc-studio/ui": "workspace:*",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependencies": {
    "@trpc/server": ">=10 <12",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "trpc",
    "express",
    "adapter",
    "middleware"
  ],
  "author": "tRPC Studio Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trpc/trpc-studio.git",
    "directory": "packages/express"
  }
}
