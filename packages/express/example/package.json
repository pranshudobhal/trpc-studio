{
  "name": "express-studio-example",
  "version": "1.0.0",
  "description": "Example Express application with tRPC Studio",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "tsc server.ts --outDir dist",
    "prod": "NODE_ENV=production TRPC_STUDIO_ENABLED=true TRPC_STUDIO_TOKEN=demo-token-123 tsx server.ts"
  },
  "dependencies": {
    "@trpc/server": "^11.0.0",
    "express": "^4.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
