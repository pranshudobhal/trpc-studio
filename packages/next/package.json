{
  "name": "@trpc-studio/next",
  "version": "0.1.0",
  "description": "Next.js adapter for tRPC Studio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "echo 'No linting for next'",
    "e2e": "echo 'No E2E for next'",
    "size": "echo 'No size check for next'"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@trpc-studio/core": "workspace:*",
    "@trpc-studio/ui": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=13",
    "@trpc/server": ">=10 <12",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "keywords": [
    "trpc",
    "nextjs",
    "adapter",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trpc-studio/trpc-studio.git",
    "directory": "packages/next"
  }
}
