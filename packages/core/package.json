{
  "name": "@trpc-studio/core",
  "version": "0.1.0",
  "description": "Core utilities for tRPC Studio - router introspection, schema conversion, and security",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "echo 'No linting for core'",
    "e2e": "echo 'No E2E for core'",
    "size": "echo 'No size check for core'"
  },
  "engines": {
    "node": ">=18.18"
  },
  "peerDependencies": {
    "@trpc/server": ">=10 <12",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "keywords": [
    "trpc",
    "api",
    "documentation",
    "introspection",
    "schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trpc-studio/trpc-studio.git",
    "directory": "packages/core"
  }
}
